  {
    "id": "entity-customer",
    "kind": "entity",
    "describe": "Customer entity derives from customers with a plan dimension and a row count",
    "entity": "Customer",
    "table": "customers",
    "measures": ["customers_count"],
    "dimensions": ["plan"]
  },
  {
    "id": "entity-order-item",
    "kind": "entity",
    "describe": "OrderItem exposes a summable quantity — the measure revenue questions build on",
    "entity": "OrderItem",
    "table": "order_items",
    "measures": ["order_items_count", "sum_quantity"]
  },
  {
    "id": "entity-product",
    "kind": "entity",
    "describe": "Product exposes unit_price as a measure and is grouped by name",
    "entity": "Product",
    "table": "products",
    "measures": ["sum_unit_price"]
  },
  {
    "id": "metric-count-compiles",
    "kind": "metric",
    "describe": "a plain count on the entity's own table compiles",
    "metric": { "metric": "customers_count" }
  },
  {
    "id": "metric-count-by-own-dimension",
    "kind": "metric",
    "describe": "counting customers grouped by their own plan compiles",
    "metric": { "metric": "customers_count", "dimensions": ["plan"] }
  },
  {
    "id": "metric-refuses-fanout",
    "kind": "metric",
    "describe": "summing order_items quantity grouped by a customer dimension must be REFUSED — the join fans the measure out",
    "metric": { "metric": "sum_quantity", "dimensions": ["plan"] },
    "expectRefusal": true
  },
  {
    "id": "metric-refuses-unknown",
    "kind": "metric",
