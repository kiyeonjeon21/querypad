{
  "name": "querypad",
  "version": "0.6.0",
  "private": true,
  "description": "Cursor for Data — a local-first AI CLI that understands datasets (discovers relationships, builds semantic models) and analyzes them with DuckDB.",
  "author": "QueryPad Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vericontext/querypad.git"
  },
  "homepage": "https://querypad.io",
  "bin": {
    "querypad": "src/cli/index.ts"
  },
  "keywords": [
    "cursor-for-data",
    "duckdb",
    "sql",
    "ai",
    "llm",
    "data-understanding",
    "relationship-discovery",
    "semantic-model",
    "schema-inference",
    "data-analysis",
    "csv",
    "parquet",
    "cli",
    "claude",
    "local-first"
  ],
  "scripts": {
    "querypad": "tsx src/cli/index.ts",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run lint && npm run typecheck",
    "version": "npm run check:version",
    "test:cli": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
