{
  "name": "querypad",
  "version": "0.7.0",
  "private": true,
  "description": "Cursor for Data \u2014 a local-first AI CLI that understands datasets (discovers relationships, builds semantic models) and analyzes them with DuckDB.",
  "author": "QueryPad Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vericontext/querypad.git"
  },
  "homepage": "https://querypad.io",
  "bin": {
    "querypad": "dist/querypad.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "claude",
    "cli",
    "csv",
    "cursor-for-data",
    "data-analysis",
    "data-understanding",
    "duckdb",
    "llm",
    "local-first",
    "mcp",
    "model-context-protocol",
    "parquet",
    "relationship-discovery",
    "schema-inference",
    "semantic-model",
    "sql"
  ],
  "scripts": {
    "querypad": "tsx src/adapters/cli/index.ts",
    "build": "tsup",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run lint && npm run typecheck && npm run build",
    "version": "npm run check:version",
    "test:cli": "node --import tsx --test test/*.test.ts",
    "eval:engine": "tsx src/adapters/cli/index.ts eval engine",
    "eval:agent": "tsx src/adapters/cli/index.ts eval agent"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20",
    "eslint": "^9",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
